PORT=3001
NODE_ENV=development

# ── Anthropic Claude AI ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Google Cloud Platform ───────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable: Cloud Text-to-Speech API, Cloud Speech-to-Text API
GOOGLE_API_KEY=AIza-your-google-api-key-here

# Chirp 3 HD Voice selection (see /api/voice/voices for full list)
# Options: en-IN-Chirp3-HD-Aoede | en-IN-Chirp3-HD-Charon | en-IN-Chirp3-HD-Kore
# en-US-Chirp3-HD-Charon | en-US-Chirp3-HD-Aoede | en-US-Chirp3-HD-Puck
GOOGLE_TTS_VOICE=en-IN-Chirp3-HD-Aoede
GOOGLE_TTS_LANGUAGE=en-IN
GOOGLE_STT_LANGUAGE=en-IN
GOOGLE_STT_MODEL=chirp_2

# ── Razorpay Payment Gateway ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── App Config ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
DB_PATH=./db/urbanklean.json

# TTS audio cache TTL in seconds (3600 = 1 hour)
TTS_CACHE_TTL=3600
